rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Users — bisa dibaca semua yang login, hanya admin yang bisa write
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('ADMIN');
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Materi pembelajaran
    match /materials/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('GURU_MAPEL') || hasRole('ADMIN');
    }

    // Tugas
    match /assignments/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('GURU_MAPEL') || hasRole('ADMIN');
    }

    // Submisi tugas siswa
    match /submissions/{id} {
      allow read: if isAuthenticated();
      allow create: if hasRole('SISWA');
      allow update: if hasRole('GURU_MAPEL') || hasRole('ADMIN');
    }

    // Kuis
    match /quizzes/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('GURU_MAPEL') || hasRole('ADMIN');
    }

    // Absensi
    match /absences/{id} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole('GURU_MAPEL') || hasRole('GURU_PIKET') || hasRole('ADMIN');
    }

    // Pelanggaran
    match /violations/{id} {
      allow read: if isAuthenticated();
      allow create, update: if getUserData().role in ['WALI_KELAS', 'GURU_BK', 'GURU_PIKET', 'ADMIN'];
    }

    // Konseling BK — hanya BK dan siswa ybs
    match /konseling/{id} {
      allow read, write: if isAuthenticated() &&
        (resource.data.student_id == request.auth.uid || hasRole('GURU_BK'));
      allow create: if isAuthenticated();
    }

    // Chat messages
    match /chats/{chatId}/messages/{msgId} {
      allow read, write: if isAuthenticated();
    }

    // Notifikasi
    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('GURU_PIKET') || hasRole('WALI_KELAS') || hasRole('ADMIN');
    }

    // Pengumuman
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('ADMIN') || hasRole('GURU_PIKET');
    }

    // Jadwal
    match /schedules/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('ADMIN');
    }

    // Buku piket
    match /piket_log/{id} {
      allow read: if isAuthenticated();
      allow write: if hasRole('GURU_PIKET') || hasRole('ADMIN');
    }

    // Counseling collection (alias)
    match /counseling/{id} {
      allow read, write: if isAuthenticated() &&
        (request.auth.uid == resource.data.student_id || hasRole('GURU_BK'));
      allow create: if isAuthenticated();
    }
  }
}
